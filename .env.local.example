# Copy this file to .env.local for local development, and add the same
# values in your hosting provider's dashboard (e.g. Vercel → Project →
# Settings → Environment Variables) for the deployed site.

# Public — safe to expose in the browser. Found in Supabase: Project
# Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET — server-only. Never prefix this with NEXT_PUBLIC_, never commit it,
# never put it in client-side code. Found in Supabase: Project Settings → API
# → "service_role" key (NOT the anon key).
SUPABASE_SERVICE_ROLE_KEY=

# SECRET — whatever passcode you want to use to unlock your /inbox page.
# Pick something only you know.
INBOX_PASSCODE=
